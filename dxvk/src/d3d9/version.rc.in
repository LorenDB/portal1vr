#include <windows.h>

// DLL version information. The Meson build fills in the git describe string.
VS_VERSION_INFO    VERSIONINFO
FILEVERSION        0,0,0,0
PRODUCTVERSION     0,0,0,0
FILEFLAGSMASK      VS_FFI_FILEFLAGSMASK
FILEFLAGS          0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_DLL
FILESUBTYPE VFT2_UNKNOWN
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "080904b0"
    BEGIN
      VALUE "CompanyName",      "Portal1VR"
      VALUE "FileDescription",  "Portal 1 VR runtime (modified DXVK)"
      VALUE "FileVersion",      "@VCS_TAG@"
      VALUE "InternalName",     "d3d9.dll"
      VALUE "LegalCopyright",   "Modified DXVK. zlib/libpng license. Not an original DXVK release."
      VALUE "OriginalFilename", "d3d9.dll"
      VALUE "ProductName",      "Portal1VR"
      VALUE "ProductVersion",   "@VCS_TAG@"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x0809, 1200
  END
END
